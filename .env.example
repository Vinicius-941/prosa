# Production service settings. Use an absolute persistent directory for PROSA_DATA_DIR.
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
PROSA_DATA_DIR=/var/lib/prosa
CLIENT_ORIGIN=https://prosa.example.com
PROSA_DOMAIN=prosa.example.com
TURN_URL=turn:prosa.example.com:3478?transport=udp,turn:prosa.example.com:3478?transport=tcp
TURN_EXTERNAL_IP=203.0.113.10
TURN_SHARED_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
